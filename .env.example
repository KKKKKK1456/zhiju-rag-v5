# Copy this file to .env. Never commit .env.
# API keys are configured in your own RAGFlow UI, NOT in this file.
RAGFLOW_CONTAINER=ragflow-server
RAGFLOW_DATASET_ID=
# Internal tenant CHAT model row ID, not a model display name. Only needed for cloud answers.
RAGFLOW_CHAT_MODEL_ID=
RAGFLOW_WORKDIR=/ragflow
RAGFLOW_PYTHON=/ragflow/.venv/bin/python
# Blank means direct TLS connection to api.moonshot.cn. Optional local proxy only.
KIMI_PROXY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=bge-m3:latest
# Paste the full digest returned by your local Ollama /api/tags. No sha256: prefix.
OLLAMA_MODEL_DIGEST=
QWEN_MODEL_PATH=models/qwen3-reranker-0.6b
# cpu works without an Apple GPU; mps is for supported Apple Silicon Macs.
QWEN_DEVICE=cpu
VECTOR_CACHE_PATH=runtime/article_vectors.sqlite3

