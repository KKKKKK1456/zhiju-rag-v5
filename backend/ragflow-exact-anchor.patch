+    @classmethod
+    def _merge_search_results(cls, primary: SearchResult, supplemental: SearchResult) -> SearchResult:
+        """Union a small lexical recall set into the primary candidate window."""
+
+        ids = list(primary.ids)
+        seen = set(ids)
+        for chunk_id in supplemental.ids:
+            if chunk_id not in seen:
+                seen.add(chunk_id)
+                ids.append(chunk_id)
+
+        field = dict(supplemental.field or {})
+        field.update(primary.field or {})
+        if primary.highlight is None and supplemental.highlight is None:
+            highlight = None
+        else:
+            highlight = dict(supplemental.highlight or {})
+            highlight.update(primary.highlight or {})
+
+        keywords = list(primary.keywords or [])
+        keyword_seen = set(keywords)
+        for keyword in supplemental.keywords or []:
+            if keyword not in keyword_seen:
+                keyword_seen.add(keyword)
+                keywords.append(keyword)
+
+        return cls.SearchResult(
+            total=len(ids),
+            ids=ids,
+            query_vector=primary.query_vector,
+            field=field,
+            highlight=highlight,
+            aggregation=primary.aggregation,
+            keywords=keywords,
+            group_docs=primary.group_docs,
