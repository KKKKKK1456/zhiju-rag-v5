+"""Query normalization and exact-anchor helpers for hybrid retrieval.
+
+The helpers are deliberately domain-neutral.  They protect identifiers and
+explicitly quoted names that embedding search commonly treats as incidental,
+without embedding product-, document-, or benchmark-specific vocabulary in
+the retrieval path.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+
+_DASHES = str.maketrans({
+    "‐": "-",
+    "‑": "-",
+    "‒": "-",
+    "–": "-",
+    "—": "-",
+    "−": "-",
+    "﹣": "-",
+    "－": "-",
+})
+_ZERO_WIDTH_RE = re.compile("[\u200b-\u200d\ufeff]")
+_SPACE_RE = re.compile(r"\s+")
+_MIXED_IDENTIFIER_RE = re.compile(
+    r"(?<![A-Z0-9])(?=[A-Z0-9._/-]{5,})(?=[A-Z0-9._/-]*[A-Z])(?=[A-Z0-9._/-]*\d)[A-Z0-9][A-Z0-9._/-]*(?![A-Z0-9])",
+    re.IGNORECASE,
+)
+_LONG_NUMBER_RE = re.compile(r"(?<!\d)\d{6,}(?!\d)")
+_DOCUMENT_NUMBER_RE = re.compile(
+    r"(?:(?:〔|\[|\()\d{4}(?:〕|\]|\))(?:年)?(?:第)?\d{1,6}号|\d{4}年第?\d{1,6}号)"
+)
+_QUOTED_RE = re.compile(r"《([^《》]{3,80})》|[\"“]([^\"”\n]{3,80})[\"”]")
+
+
+def normalize_query(text: str) -> str:
+    """Normalize presentation variants while preserving query meaning."""
+
+    normalized = unicodedata.normalize("NFKC", str(text or ""))
+    normalized = _ZERO_WIDTH_RE.sub("", normalized).translate(_DASHES)
+    return _SPACE_RE.sub(" ", normalized).strip()
+
+
+def normalize_for_exact_match(text: str) -> str:
+    """Return a punctuation-insensitive canonical form for exact coverage."""
+
+    normalized = normalize_query(text).upper()
+    return "".join(character for character in normalized if character.isalnum())
+
+
+def extract_exact_anchors(text: str, *, limit: int = 8) -> list[str]:
+    """Extract stable literal anchors from a natural-language query.
+
+    Mixed letter/number identifiers, long numeric identifiers, legal-style
+    document numbers, and explicitly quoted names are precise enough to merit
+    an additional lexical candidate lookup.  Ordinary words are intentionally
+    excluded so normal semantic queries keep their existing latency profile.
+    """
+
+    normalized = normalize_query(text)
+    candidates: list[tuple[int, str]] = []
+
+    for match in _QUOTED_RE.finditer(normalized):
+        value = next(group for group in match.groups() if group is not None)
+        candidates.append((match.start(), value.strip()))
+    for pattern in (_MIXED_IDENTIFIER_RE, _LONG_NUMBER_RE, _DOCUMENT_NUMBER_RE):
+        candidates.extend((match.start(), match.group(0).strip()) for match in pattern.finditer(normalized))
+
+    anchors: list[str] = []
+    seen: set[str] = set()
+    for _, candidate in sorted(candidates, key=lambda item: item[0]):
+        canonical = normalize_for_exact_match(candidate)
+        if len(canonical) < 4 or canonical in seen:
+            continue
+        seen.add(canonical)
+        anchors.append(candidate)
+        if len(anchors) >= limit:
+            break
+    return anchors
+
+
+def exact_anchor_coverage(anchors: list[str], *texts: str) -> float:
+    """Return the fraction of query anchors literally present in the texts."""
+
+    canonical_anchors = [normalize_for_exact_match(anchor) for anchor in anchors]
+    canonical_anchors = [anchor for anchor in canonical_anchors if anchor]
+    if not canonical_anchors:
+        return 0.0
+    haystack = normalize_for_exact_match(" ".join(str(text or "") for text in texts))
+    return sum(anchor in haystack for anchor in canonical_anchors) / len(canonical_anchors)
