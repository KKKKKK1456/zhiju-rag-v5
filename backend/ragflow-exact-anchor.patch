+    @staticmethod
+    def _blend_exact_anchor_scores(sres: SearchResult, sim, anchors: list[str]):
+        """Make a literal full-anchor match outrank non-matching candidates."""
+
+        scores = np.array(sim, dtype=np.float64)
+        if not anchors or scores.size == 0:
+            return scores, np.zeros(scores.size, dtype=np.float64)
+
+        coverage = np.array(
+            [
+                exact_anchor_coverage(
+                    anchors,
+                    sres.field[chunk_id].get("content_with_weight", ""),
+                    sres.field[chunk_id].get("docnm_kwd", ""),
+                )
+                for chunk_id in sres.ids
+            ],
+            dtype=np.float64,
+        )
+        # Exactness owns the majority of the final score only when the query
+        # itself contains a precise anchor.  Semantic relevance still orders
+        # rows with equal literal coverage.
+        return 0.4 * scores + 0.6 * coverage, coverage
